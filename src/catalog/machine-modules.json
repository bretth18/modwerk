      "schemaVersion": 3,
      "id": "digislicer",
      "name": "DIGISLICER",
      "version": "2.1.0-experimental",
      "machine": "digitakt",
      "category": "machines",
      "exclusive": false,
      "author": {
        "github": "irpina",
        "credits": [
          "irpina — DIGISLICER design and code"
        ]
      },
      "maintainers": [
        "irpina"
      ],
      "presentation": {
        "label": "DIGISLICER",
        "family": "Sampling",
        "summary": "A slicing machine with a slice editor: cut a sample where you want, and play the slices from the trig keys and the keyboard.",
        "overview": "DIGISLICER is the SLICE machine with a slice editor. Its SRC page is SLICE’s; press SRC again for a waveform view where you add, split, delete and move slices, auto-slice on transients or use equal grids, watch them play and play them from the trig keys. A sample’s own slices play on every DIGISLICER track and are kept per sample on the +Drive. GRID gains AUTO (slices on the transients) and PLAY gains PIPO (ping-pong loops). With the keyboard on, the trig keys play the slices one per key, as the Octatrack’s trig slice mode, and live recording records them as slice locks. The stock SLICE machine is left as it is.",
        "highlights": [
          "A slice editor on the track’s sample, opened by pressing SRC twice.",
          "Your slices are saved per sample on the +Drive and play on every DIGISLICER track.",
          "GRID = AUTO slices on transients; PLAY = PIPO ping-pong loops.",
          "Trig keys play slices one per key, with live recording as slice locks."
        ],
        "usage": [
          "Chop a break by hand in the editor, then play the slices from the trig keys.",
          "Use AUTO on drum loops that have no slices of their own."
        ]
      },
      "access": {
        "location": "SRC machine list, below SLICE",
        "steps": [
          "Select a track, press FUNC + SRC and choose DIGISLICER below SLICE.",
          "Press SRC again to open the slice editor; SRC, NO or another page key closes it."
        ],
        "screenshots": []
      },
      "controls": [
        {
          "name": "Knob A",
          "default": null,
          "doc": "Select a slice in the editor",
          "labels": null
        },
        {
          "name": "Knob B",
          "default": null,
          "doc": "Move the slice start",
          "labels": null
        },
        {
          "name": "Knob C",
          "default": null,
          "doc": "Move the start by single samples",
          "labels": null
        },
        {
          "name": "Knob D",
          "default": null,
          "doc": "Zoom horizontally around the cursor",
          "labels": null
        },
        {
