          "default": null,
          "doc": "Zoom vertically, up to 64 times",
          "labels": null
        },
        {
          "name": "LEVEL",
          "default": null,
          "doc": "Move the cursor; the waveform scrolls with it",
          "labels": null
        },
        {
          "name": "FUNC + YES",
          "default": null,
