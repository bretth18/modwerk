    {
      "schemaVersion": 3,
      "id": "digisophie",
      "name": "SOPHIE",
      "version": "1.1.13-experimental.1",
      "machine": "digitakt",
      "category": "machines",
      "exclusive": false,
      "author": {
        "github": "soejrd",
        "credits": [
          "Sjoerd (Soejrd) — DigiSophie development and Digitakt adaptation",
          "Matt Estela (@mestela) — original Sophie for Schwung algorithm"
        ],
        "name": "Sjoerd (Soejrd)"
      },
      "maintainers": [
        "soejrd"
      ],
      "presentation": {
        "label": "SOPHIE",
        "family": "Synthesis",
        "summary": "A metallic percussion machine with four models: FUSE, BOOM, PIPE and SHARD.",
        "overview": "Sophie is a metallic percussion synth machine for the original Digitakt. It began as a fixed-point adaptation of Sophie for Schwung by Matt Estela and evolved into four models: FUSE, BOOM, PIPE and SHARD. Its audio enters the normal Digitakt AMP, filter, mixer and sends; the custom controls can be parameter-locked.",
        "highlights": [
          "Four metallic percussion models: FUSE, BOOM, PIPE and SHARD.",
          "FOLD wavefolder with output level compensation.",
          "Uses the Digitakt’s own AMP, filter, mixer and effects."
        ],
        "usage": [
          "Program metallic hits and bells with parameter-locked MODEL and METAL.",
          "Use AMP HOLD = NOTE so TRIG LEN sets when the release begins."
        ]
      },
      "access": {
