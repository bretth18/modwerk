      "schemaVersion": 3,
      "id": "digihealth",
      "name": "digihealth",
      "version": "1.0.1-experimental",
      "machine": "digitakt",
      "category": "system",
      "exclusive": false,
      "author": {
        "github": "irpina",
        "credits": [
          "irpina — digihealth design and code"
        ]
      },
      "maintainers": [
        "irpina"
      ],
      "presentation": {
        "label": "DIGIHEALTH",
        "family": "Performance",
        "summary": "FAST AUDIO lowers the DSP load; SYSTEM INFO shows CPU, DSP and memory in the top bar.",
        "overview": "Two SETTINGS rows. FAST AUDIO (on by default) runs the audio render’s hot code from the free on-chip SRAM: the same code, so the audio is identical and the DSP load lower; a watchdog goes back to the stock code if the copy is ever overwritten. SYSTEM INFO shows CPU, DSP, RAM and free sample memory in the top bar, and a read-only USB diagnostics channel (SysEx device 0x7D) answers its desktop tool.",
        "highlights": [
          "FAST AUDIO: the render’s hot code runs from on-chip SRAM for a lower DSP load.",
          "A watchdog falls back to the stock code if the copy is overwritten.",
          "SYSTEM INFO: CPU, DSP, RAM and free sample memory in the top bar."
        ],
        "usage": [
          "Turn FAST AUDIO on to make room for heavier machines such as SOPHIE.",
          "Watch DSP peaks with SYSTEM INFO while building a pattern."
        ]
      },
      "access": {
        "location": "SETTINGS",
        "steps": [
          "Open SETTINGS.",
          "Tick FAST AUDIO or SYSTEM INFO."
        ],
        "screenshots": []
      },
      "controls": [
        {
          "name": "FAST AUDIO",
          "default": null,
          "doc": "Runs the render from SRAM; untick to stop until the next power-on",
          "labels": null
        },
        {
          "name": "SYSTEM INFO",
          "default": null,
          "doc": "Shows CPU, DSP and memory in the top bar",
          "labels": null
        }
      ],
      "compatibility": {
        "releases": [
          "1.53",
          "1.54"
        ],
        "requires": [],
        "conflicts": [],
        "limitations": [
