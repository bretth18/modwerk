{
  "name": "octamod-community",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["17 * * * *"] },
  // Production values. Local development overrides vars through the ignored .dev.vars file.
  "vars": {
    "APP_URL": "https://modwerk.app/",
    "AUTH_BASE_URL": "https://octamod-community.octamod.workers.dev/api/auth",
    "REGISTRATION_OPEN": "false",
    "PRIVACY_READY": "false",
    "SESSION_TRANSPORT": "bearer",
    // Activity digests per day. 15 leaves the free Resend tier (100/day) room for account mail; raise after upgrading.
    "ACTIVITY_MAIL_DAILY_LIMIT": "15"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "octamod-community",
      "database_id": "ef3ad4a1-5554-45a6-a841-6314367e3cec",
      "migrations_dir": "migrations"
    }
  ],
  // Module screenshots and audio arrive through PRs and are served by the site; no R2 bucket is needed.
  "main": "worker.ts"
}
