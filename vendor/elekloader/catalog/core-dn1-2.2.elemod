{
 "elemod": 2,
 "id": "core",
 "version": "2.2",
 "title": "core",
 "description": "The boot copier and the hook bus for the Digitone mk1 and Digitone Keys: every other mod needs it. From 2.1 also the voice note-on event, parameter slots, mod pages and project data, and from 2.2 the Mod Menu (hold a track key). On its own it changes nothing the unit does.",
 "category": "Framework",
 "author": "irpina",
 "license": "GPL-2.0-or-later",
